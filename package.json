{
  "name": "leavewell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4310 --strictPort",
    "start": "node server.mjs",
    "test": "npm run typecheck:tooling && vitest run --maxWorkers=1 --minWorkers=1",
    "test:e2e": "playwright test",
    "lint": "oxlint .",
    "check": "npm run lint && npm test && npm run build",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt --write",
    "format:check": "oxfmt --check",
    "typecheck:tooling": "tsc --noEmit -p tsconfig.tooling.json && tsc --noEmit -p public/tsconfig.json"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "lucide-react": "0.552.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@aranlucas/oxforge": "^0.1.3",
    "@aranlucas/oxlint-plugin-anti-slop": "0.1.0",
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "oxlint-tsgolint": "^7.0.2004",
    "portless": "0.15.7",
    "prettier": "3.5.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "2.1.9"
  }
}
