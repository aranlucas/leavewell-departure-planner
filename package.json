{
  "name": "leavewell",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "portless run vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4310 --strictPort",
    "start": "node server.mjs",
    "test": "vitest run --maxWorkers=1 --minWorkers=1",
    "test:e2e": "playwright test",
    "lint": "oxlint .",
    "check": "npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@js-temporal/polyfill": "0.5.1",
    "lucide-react": "0.552.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "4.7.0",
    "prettier": "3.5.2",
    "typescript": "5.9.3",
    "vite": "6.4.3",
    "vitest": "2.1.9",
    "oxlint": "1.86.0",
    "@oxlint/plugins": "1.86.0",
    "portless": "0.15.7"
  }
}
